post_install() {
    if [ -f /etc/fprintd-prompt.conf ]; then
        echo "Regenerating custom prompt catalog..."
        /usr/bin/fprintd-prompt apply || \
            echo "Warning: failed to regenerate catalog. Run 'fprintd-prompt apply' manually."
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /var/lib/fprintd-prompt/fprintd.mo
    rmdir --ignore-fail-on-non-empty /var/lib/fprintd-prompt 2>/dev/null || true
    echo "Custom prompt catalog removed. Upstream fprintd prompts are now active."
    echo "To fully clean up, remove /etc/fprintd-prompt.conf if it exists."
}
